{
  "manifest_version": 3,
  "name": "Decalque",
  "short_name": "Decalque",
  "version": "1.0.0",
  "description": "Decalque o design de qualquer site ou arquivo do Figma: cores, tipografia, espaçamento, sombras, animações, imagens e componentes prontos para o seu projeto.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Decalque — abrir painel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Abrir o Decalque"
    }
  }
}
